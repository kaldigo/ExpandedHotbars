<Project Sdk="Dalamud.NET.Sdk/15.0.0">
    <PropertyGroup>
        <Version>1.0.1.1</Version>
    </PropertyGroup>

    <PropertyGroup>
        <Name>ExpandedHotbars</Name>
        <Author>kaldigo; based on MidoriKami's ExpandedHotbars</Author>
        <Punchline>Add and control an unlimited number of custom additional hotbars.</Punchline>
        <Description>Create hotbars of any size, spacing, and keybinds, with functions to show and hide these bars dynamically.</Description>
        <RepoUrl>https://github.com/kaldigo/ExpandedHotbars</RepoUrl>
        <IconUrl>https://raw.githubusercontent.com/kaldigo/ExpandedHotbars/master/ExpandedHotbars/images/icon.png</IconUrl>
        <Tags>hotbars</Tags>
        <AcceptsFeedback>false</AcceptsFeedback>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\CodeGenerator\CodeGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\KamiToolKit\KamiToolKit.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="images\icon.png" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
</Project>
